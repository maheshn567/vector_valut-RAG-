# PostgreSQL connection string (required, must have the pgvector extension enabled)
DATABASE_URL="postgresql://user:password@localhost:5432/vectorvault?schema=public"

# Auth (required)
JWT_SECRET_KEY=
JWT_EXPIRES_IN=7d

# Google OAuth login (required only if enabling Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret sent as X-API-Key when calling the Python microservices (required)
RAG_SERVICE_API_KEY=

NODE_ENV=development
PORT=5000
BETTER_AUTH_URL=http://localhost:5000
